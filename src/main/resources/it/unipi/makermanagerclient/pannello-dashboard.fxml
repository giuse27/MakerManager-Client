<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.DashboardController"
      spacing="14.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label fx:id="etichettaBenvenuto" styleClass="section-title" text="Benvenuto in MakerManager" />

        <HBox styleClass="toolbar" spacing="14.0">
            <children>
                <Label fx:id="etichettaStatoServer" styleClass="stat-chip" text="Stato server: -" />
                <Label fx:id="etichettaTotaleProgetti" styleClass="stat-chip" text="Totale progetti: -" />
                <Label fx:id="etichettaMieiProgetti" styleClass="stat-chip" text="I miei progetti: -" />
                <Label fx:id="etichettaNumeroConsigliati" styleClass="stat-chip" text="Progetti consigliati: -" />
            </children>
        </HBox>

        <Label styleClass="section-title" text="Progetti consigliati" />

        <TableView fx:id="tabellaConsigliati" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonnaNome" text="Nome del progetto" prefWidth="280.0" />
                <TableColumn fx:id="colonnaAutore" text="Autore" prefWidth="160.0" />
                <TableColumn fx:id="colonnaFattibilita" text="Fattibilità" prefWidth="260.0" />
            </columns>
        </TableView>

    </children>
</VBox>
