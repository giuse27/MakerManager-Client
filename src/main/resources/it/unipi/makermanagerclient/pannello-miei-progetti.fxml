<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.MieiProgettiController"
      spacing="14.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <HBox spacing="14.0">
            <children>
                <Button text="Crea nuovo progetto" onAction="#onCreaProgetto" />
                <Button text="Elimina progetto" onAction="#onEliminaProgetto" />
            </children>
        </HBox>

        <Label fx:id="etichettaTitolo" text="I tuoi progetti" />

        <TableView fx:id="tabellaProgetti" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonnaNome" text="Nome del progetto" prefWidth="280.0" />
                <TableColumn fx:id="colonnaDescrizione" text="Descrizione" prefWidth="400.0" />
            </columns>
        </TableView>

    </children>
</VBox>
