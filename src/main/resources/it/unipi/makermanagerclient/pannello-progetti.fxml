<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Pannello Progetti.

    NOTA IMPORTANTE: idProgetto NON e' un campo di questo file: e'
    definito una sola volta nella sidebar (shell.fxml) perche' condiviso
    tra piu' blocchi di questo pannello (dettaglio, elimina, aggiungi/
    elimina riga BOM). ProgettoController riceve lo Spinner da
    ShellController dopo il caricamento.
-->

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.makermanagerclient.controller.ProgettoController">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label styleClass="panel-title" text="Progetti" />

        <ScrollPane fitToWidth="true" styleClass="output-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="14.0">
                    <children>

                        <!-- Visualizza tutti i progetti -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Tutti i progetti" />
                                <Button fx:id="bottoneTuttiIProgetti" maxWidth="Infinity" onAction="#onTuttiIProgetti" text="GET /api/progetti" />
                            </children>
                        </VBox>

                        <!-- Dettaglio progetto -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Dettaglio progetto (con BOM)" />
                                <Label styleClass="hint-label" text="usa idProgetto dalla sidebar" />
                                <Button fx:id="bottoneDettaglioProgetto" maxWidth="Infinity" onAction="#onDettaglioProgetto" text="GET /api/progetti/{idProgetto}" />
                            </children>
                        </VBox>

                        <!-- Progetti per tipologia -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Progetti per tipologia" />
                                <ComboBox fx:id="comboTipologiaFiltro" maxWidth="Infinity" promptText="tipologia" />
                                <Button fx:id="bottoneProgettiPerTipologia" maxWidth="Infinity" onAction="#onProgettiPerTipologia" text="GET /api/progetti/tipologia/{tipologia}" />
                            </children>
                        </VBox>

                        <!-- Crea progetto -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Crea progetto" />
                                <ComboBox fx:id="comboTipologiaCrea" maxWidth="Infinity" promptText="tipo" />
                                <TextField fx:id="campoNomeProgetto" promptText="nome" />
                                <TextField fx:id="campoDescrizioneProgetto" promptText="descrizione" />
                                <Button fx:id="bottoneCreaProgetto" maxWidth="Infinity" onAction="#onCreaProgetto" text="POST /api/progetti" />
                            </children>
                        </VBox>

                        <!-- Elimina progetto -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Elimina progetto" />
                                <Label styleClass="hint-label" text="usa idProgetto dalla sidebar" />
                                <Button fx:id="bottoneEliminaProgetto" maxWidth="Infinity" onAction="#onEliminaProgetto" styleClass="danger" text="DELETE /api/progetti/{idProgetto}" />
                            </children>
                        </VBox>

                        <!-- Aggiungi riga BOM -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Aggiungi riga BOM" />
                                <Label styleClass="hint-label" text="usa idProgetto dalla sidebar" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdElementoCatalogoBom" editable="true" prefWidth="140.0" />
                                        <Spinner fx:id="spinnerQuantitaBom" editable="true" prefWidth="110.0" />
                                    </children>
                                </HBox>
                                <Button fx:id="bottoneAggiungiRigaBom" maxWidth="Infinity" onAction="#onAggiungiRigaBom" text="POST /api/progetti/{idProgetto}/bom" />
                            </children>
                        </VBox>

                        <!-- Elimina riga BOM -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Elimina riga BOM" />
                                <Label styleClass="hint-label" text="usa idProgetto dalla sidebar" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdRigaBom" editable="true" prefWidth="120.0" />
                                        <Button fx:id="bottoneEliminaRigaBom" maxWidth="Infinity" onAction="#onEliminaRigaBom" styleClass="danger" text="DELETE .../bom/{idRiga}" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Label styleClass="output-title" text="Output" />
        <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="842.0" prefWidth="517.0" styleClass="output-scroll">
            <content>
                <TextArea fx:id="areaOutput" editable="false" prefHeight="748.0" prefWidth="515.0" styleClass="output-area" wrapText="true" />
            </content>
        </ScrollPane>

    </children>
</VBox>
