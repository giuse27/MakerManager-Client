<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Pannello Progetti.

    NOTA IMPORTANTE: idProgetto NON e' un campo di questo file: e'
    definito una sola volta nella sidebar (shell.fxml) perche' condiviso
    tra piu' blocchi di questo pannello (dettaglio, elimina, aggiungi/
    elimina riga BOM). ProgettoController riceve lo Spinner da
    ShellController dopo il caricamento.
-->
<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.ProgettoController"
      spacing="8.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <children>

        <Label text="Progetti" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="8.0">
                    <children>

                        <!-- Visualizza tutti i progetti -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Tutti i progetti" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Button fx:id="bottoneTuttiIProgetti" text="GET /api/progetti" maxWidth="Infinity" onAction="#onTuttiIProgetti" />
                            </children>
                        </VBox>

                        <!-- Dettaglio progetto -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Dettaglio progetto (con BOM)" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idProgetto dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <Button fx:id="bottoneDettaglioProgetto" text="GET /api/progetti/{idProgetto}" maxWidth="Infinity" onAction="#onDettaglioProgetto" />
                            </children>
                        </VBox>

                        <!-- Progetti per tipologia -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Progetti per tipologia" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <ComboBox fx:id="comboTipologiaFiltro" maxWidth="Infinity" promptText="tipologia" />
                                <Button fx:id="bottoneProgettiPerTipologia" text="GET /api/progetti/tipologia/{tipologia}" maxWidth="Infinity" onAction="#onProgettiPerTipologia" />
                            </children>
                        </VBox>

                        <!-- Crea progetto -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Crea progetto" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <ComboBox fx:id="comboTipologiaCrea" maxWidth="Infinity" promptText="tipo" />
                                <TextField fx:id="campoNomeProgetto" promptText="nome" />
                                <TextField fx:id="campoDescrizioneProgetto" promptText="descrizione" />
                                <Button fx:id="bottoneCreaProgetto" text="POST /api/progetti" maxWidth="Infinity" onAction="#onCreaProgetto" />
                            </children>
                        </VBox>

                        <!-- Elimina progetto -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Elimina progetto" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idProgetto dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <Button fx:id="bottoneEliminaProgetto" text="DELETE /api/progetti/{idProgetto}" maxWidth="Infinity" onAction="#onEliminaProgetto" />
                            </children>
                        </VBox>

                        <!-- Aggiungi riga BOM -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Aggiungi riga BOM" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idProgetto dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <HBox spacing="6.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdElementoCatalogoBom" editable="true" prefWidth="120.0" />
                                        <Spinner fx:id="spinnerQuantitaBom" editable="true" prefWidth="90.0" />
                                    </children>
                                </HBox>
                                <Button fx:id="bottoneAggiungiRigaBom" text="POST /api/progetti/{idProgetto}/bom" maxWidth="Infinity" onAction="#onAggiungiRigaBom" />
                            </children>
                        </VBox>

                        <!-- Elimina riga BOM -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Elimina riga BOM" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idProgetto dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <HBox spacing="6.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdRigaBom" editable="true" prefWidth="100.0" />
                                        <Button fx:id="bottoneEliminaRigaBom" text="DELETE .../bom/{idRiga}" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEliminaRigaBom" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Label text="Output" style="-fx-font-weight: bold;" />
        <ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="120.0">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" />
            </content>
        </ScrollPane>

    </children>
</VBox>
