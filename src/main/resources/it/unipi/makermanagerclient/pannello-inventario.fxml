<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Pannello Inventario.

    NOTA IMPORTANTE: idInventario e idUtente NON sono campi di questo
    file: sono definiti una sola volta nella sidebar (shell.fxml) perche'
    condivisi tra piu' blocchi di questo pannello. InventarioController
    riceve i relativi Spinner da ShellController dopo il caricamento
    (vedi ShellController.inizializzaControllori()).
-->
<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.InventarioController"
      spacing="8.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <children>

        <Label text="Inventario" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="8.0">
                    <children>

                        <!-- Visualizza tutti gli inventari -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Tutti gli inventari" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Button fx:id="bottoneTuttiGliInventari" text="GET /api/inventario" maxWidth="Infinity" onAction="#onTuttiGliInventari" />
                            </children>
                        </VBox>

                        <!-- Contenuto di un inventario -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Contenuto inventario" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idInventario dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <Button fx:id="bottoneContenutoInventario" text="GET /api/inventario/{idInventario}" maxWidth="Infinity" onAction="#onContenutoInventario" />
                            </children>
                        </VBox>

                        <!-- Inventari di un utente -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Inventari di un utente" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idUtente dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <Button fx:id="bottoneInventariUtente" text="GET /api/inventario/utente/{idUtente}" maxWidth="Infinity" onAction="#onInventariUtente" />
                            </children>
                        </VBox>

                        <!-- Crea nuovo inventario -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Crea inventario" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idUtente dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <TextField fx:id="campoNomeInventario" promptText="nome" />
                                <Button fx:id="bottoneCreaInventario" text="POST /api/inventario" maxWidth="Infinity" onAction="#onCreaInventario" />
                            </children>
                        </VBox>

                        <!-- Elimina inventario -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Elimina inventario" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idInventario dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <Button fx:id="bottoneEliminaInventario" text="DELETE /api/inventario/{idInventario}" maxWidth="Infinity" onAction="#onEliminaInventario" />
                            </children>
                        </VBox>

                        <!-- Aggiungi articolo -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Aggiungi articolo" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label text="usa idInventario dalla sidebar" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
                                <HBox spacing="6.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdElementoCatalogo" editable="true" prefWidth="120.0" />
                                        <Spinner fx:id="spinnerQuantitaArticolo" editable="true" prefWidth="90.0" />
                                    </children>
                                </HBox>
                                <Button fx:id="bottoneAggiungiArticolo" text="POST /api/inventario/articoli" maxWidth="Infinity" onAction="#onAggiungiArticolo" />
                            </children>
                        </VBox>

                        <!-- Elimina articolo -->
                        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <children>
                                <Label text="Elimina articolo" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <HBox spacing="6.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdArticolo" editable="true" prefWidth="100.0" />
                                        <Button fx:id="bottoneEliminaArticolo" text="DELETE /api/inventario/articoli/{id}" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEliminaArticolo" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Label text="Output" style="-fx-font-weight: bold;" />
        <ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="120.0">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" />
            </content>
        </ScrollPane>

    </children>
</VBox>
