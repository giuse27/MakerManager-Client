<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Pannello Inventario.

    NOTA IMPORTANTE: idInventario e idUtente NON sono campi di questo
    file: sono definiti una sola volta nella sidebar (shell.fxml) perche'
    condivisi tra piu' blocchi di questo pannello. InventarioController
    riceve i relativi Spinner da ShellController dopo il caricamento
    (vedi ShellController.inizializzaControllori()).
-->

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.makermanagerclient.controller.InventarioController">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label styleClass="panel-title" text="Inventario" />

        <ScrollPane fitToWidth="true" styleClass="output-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="14.0">
                    <children>

                        <!-- Visualizza tutti gli inventari -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Tutti gli inventari" />
                                <Button fx:id="bottoneTuttiGliInventari" maxWidth="Infinity" onAction="#onTuttiGliInventari" text="GET /api/inventario" />
                            </children>
                        </VBox>

                        <!-- Contenuto di un inventario -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Contenuto inventario" />
                                <Label styleClass="hint-label" text="usa idInventario dalla sidebar" />
                                <Button fx:id="bottoneContenutoInventario" maxWidth="Infinity" onAction="#onContenutoInventario" text="GET /api/inventario/{idInventario}" />
                            </children>
                        </VBox>

                        <!-- Inventari di un utente -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Inventari di un utente" />
                                <Label styleClass="hint-label" text="usa idUtente dalla sidebar" />
                                <Button fx:id="bottoneInventariUtente" maxWidth="Infinity" onAction="#onInventariUtente" text="GET /api/inventario/utente/{idUtente}" />
                            </children>
                        </VBox>

                        <!-- Crea nuovo inventario -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Crea inventario" />
                                <Label styleClass="hint-label" text="usa idUtente dalla sidebar" />
                                <TextField fx:id="campoNomeInventario" promptText="nome" />
                                <Button fx:id="bottoneCreaInventario" maxWidth="Infinity" onAction="#onCreaInventario" text="POST /api/inventario" />
                            </children>
                        </VBox>

                        <!-- Elimina inventario -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Elimina inventario" />
                                <Label styleClass="hint-label" text="usa idInventario dalla sidebar" />
                                <Button fx:id="bottoneEliminaInventario" maxWidth="Infinity" onAction="#onEliminaInventario" styleClass="danger" text="DELETE /api/inventario/{idInventario}" />
                            </children>
                        </VBox>

                        <!-- Aggiungi articolo -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Aggiungi articolo" />
                                <Label styleClass="hint-label" text="usa idInventario dalla sidebar" />
                                <HBox spacing="10.0">
                                    <children>
                              <VBox prefHeight="40.0" prefWidth="100.0">
                                 <children>
                                    <Label styleClass="hint-label" text="idElemento" />
                                              <Spinner fx:id="spinnerIdElementoCatalogo" editable="true" prefWidth="140.0" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="40.0" prefWidth="100.0">
                                 <children>
                                    <Label styleClass="hint-label" text="quantità" />
                                              <Spinner fx:id="spinnerQuantitaArticolo" editable="true" prefWidth="110.0" />
                                 </children>
                              </VBox>
                                    </children>
                                </HBox>
                                <Button fx:id="bottoneAggiungiArticolo" maxWidth="Infinity" onAction="#onAggiungiArticolo" text="POST /api/inventario/articoli" />
                            </children>
                        </VBox>

                        <!-- Elimina articolo -->
                        <VBox spacing="10.0" styleClass="card">
                            <children>
                                <Label styleClass="card-title" text="Elimina articolo (inserisci il suo idArticolo)" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdArticolo" editable="true" prefWidth="120.0" />
                                        <Button fx:id="bottoneEliminaArticolo" maxWidth="Infinity" onAction="#onEliminaArticolo" styleClass="danger" text="DELETE /api/inventario/articoli/{id}" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Label styleClass="output-title" text="Output" />
        <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="1080.0" styleClass="output-scroll">
            <content>
                <TextArea fx:id="areaOutput" editable="false" prefHeight="540.0" styleClass="output-area" wrapText="true" />
            </content>
        </ScrollPane>

    </children>
</VBox>
