<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.InventarioController"
      spacing="14.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <HBox styleClass="toolbar" spacing="14.0">
            <children>
                <Label fx:id="etichettaNumeroInventari" styleClass="stat-chip" text="Numero di inventari: -" />
                <Button fx:id="bottoneCreaInventario" text="Crea nuovo inventario" onAction="#onCreaInventario" />
                <Button fx:id="bottoneEliminaInventario" styleClass="danger" text="Elimina inventario" onAction="#onEliminaInventario" />
            </children>
        </HBox>

        <Label styleClass="section-title" text="I tuoi inventari" />

        <TableView fx:id="tabellaInventari" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonnaNomeInventario" text="Nome dell'inventario" prefWidth="300.0" />
                <TableColumn fx:id="colonnaNumeroArticoli" text="Numero di articoli presenti" prefWidth="220.0" />
            </columns>
        </TableView>

    </children>
</VBox>