<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Pannello Inventario.

    NOTA IMPORTANTE: idInventario e idUtente NON sono campi di questo
    file: sono definiti una sola volta nella sidebar (shell.fxml) perche'
    condivisi tra piu' blocchi di questo pannello. InventarioController
    riceve i relativi Spinner da ShellController dopo il caricamento
    (vedi ShellController.inizializzaControllori()).
-->
<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.InventarioController"
      spacing="14.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label text="Inventario" styleClass="panel-title" />

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="output-scroll">
            <content>
                <VBox spacing="14.0">
                    <children>

                        <!-- Visualizza tutti gli inventari -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Tutti gli inventari" styleClass="card-title" />
                                <Button fx:id="bottoneTuttiGliInventari" text="GET /api/inventario" maxWidth="Infinity" onAction="#onTuttiGliInventari" />
                            </children>
                        </VBox>

                        <!-- Contenuto di un inventario -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Contenuto inventario" styleClass="card-title" />
                                <Label text="usa idInventario dalla sidebar" styleClass="hint-label" />
                                <Button fx:id="bottoneContenutoInventario" text="GET /api/inventario/{idInventario}" maxWidth="Infinity" onAction="#onContenutoInventario" />
                            </children>
                        </VBox>

                        <!-- Inventari di un utente -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Inventari di un utente" styleClass="card-title" />
                                <Label text="usa idUtente dalla sidebar" styleClass="hint-label" />
                                <Button fx:id="bottoneInventariUtente" text="GET /api/inventario/utente/{idUtente}" maxWidth="Infinity" onAction="#onInventariUtente" />
                            </children>
                        </VBox>

                        <!-- Crea nuovo inventario -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Crea inventario" styleClass="card-title" />
                                <Label text="usa idUtente dalla sidebar" styleClass="hint-label" />
                                <TextField fx:id="campoNomeInventario" promptText="nome" />
                                <Button fx:id="bottoneCreaInventario" text="POST /api/inventario" maxWidth="Infinity" onAction="#onCreaInventario" />
                            </children>
                        </VBox>

                        <!-- Elimina inventario -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Elimina inventario" styleClass="card-title" />
                                <Label text="usa idInventario dalla sidebar" styleClass="hint-label" />
                                <Button fx:id="bottoneEliminaInventario" styleClass="danger" text="DELETE /api/inventario/{idInventario}" maxWidth="Infinity" onAction="#onEliminaInventario" />
                            </children>
                        </VBox>

                        <!-- Aggiungi articolo -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Aggiungi articolo" styleClass="card-title" />
                                <Label text="usa idInventario dalla sidebar" styleClass="hint-label" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdElementoCatalogo" editable="true" prefWidth="140.0" />
                                        <Spinner fx:id="spinnerQuantitaArticolo" editable="true" prefWidth="110.0" />
                                    </children>
                                </HBox>
                                <Button fx:id="bottoneAggiungiArticolo" text="POST /api/inventario/articoli" maxWidth="Infinity" onAction="#onAggiungiArticolo" />
                            </children>
                        </VBox>

                        <!-- Elimina articolo -->
                        <VBox styleClass="card" spacing="10.0">
                            <children>
                                <Label text="Elimina articolo" styleClass="card-title" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Spinner fx:id="spinnerIdArticolo" editable="true" prefWidth="120.0" />
                                        <Button fx:id="bottoneEliminaArticolo" styleClass="danger" text="DELETE /api/inventario/articoli/{id}" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEliminaArticolo" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Label text="Output" styleClass="output-title" />
        <ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="240.0" styleClass="output-scroll">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" styleClass="output-area" />
            </content>
        </ScrollPane>

    </children>
</VBox>
