<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.DatabaseController"
      spacing="14.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <HBox spacing="14.0">
            <children>
                <Button fx:id="bottoneInizializza" text="Inizializza" onAction="#onInizializza" />
            </children>
        </HBox>

        <Label fx:id="etichettaTitoloTabella" text="Elenco completo degli elementi presenti in catalogo (-)" />

        <TableView fx:id="tabellaElementi" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonnaNome" text="Nome elemento" prefWidth="220.0" />
                <TableColumn fx:id="colonnaDescrizione" text="Descrizione" prefWidth="320.0" />
                <TableColumn fx:id="colonnaTipologia" text="Tipologia" prefWidth="200.0" />
            </columns>
        </TableView>

    </children>
</VBox>
