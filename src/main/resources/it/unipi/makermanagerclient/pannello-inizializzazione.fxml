<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.InizializzazioneController"
      spacing="16.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label text="Inizializzazione database" styleClass="panel-title" />

        <VBox styleClass="card" spacing="10.0">
            <children>
                <Label text="Nessun parametro richiesto. Cancella e ricarica tutti i dati dal file JSON iniziale." wrapText="true" styleClass="hint-label" />
                <Button fx:id="bottoneInizializza" styleClass="danger" text="POST /inizializza" maxWidth="Infinity" onAction="#onInizializza" />
            </children>
        </VBox>

        <Label text="Output" styleClass="output-title" />
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="output-scroll">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" styleClass="output-area" />
            </content>
        </ScrollPane>

    </children>
</VBox>
