<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.InizializzazioneController"
      spacing="10.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <children>

        <Label text="Inizializzazione database" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Nessun parametro richiesto. Cancella e ricarica tutti i dati dal file JSON iniziale." wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: gray;" />
                <Button fx:id="bottoneInizializza" text="POST /inizializza" maxWidth="Infinity" onAction="#onInizializza" />
            </children>
        </VBox>

        <Label text="Output" style="-fx-font-weight: bold;" />
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" />
            </content>
        </ScrollPane>

    </children>
</VBox>
