<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.ContenutoInventarioController"
      spacing="14.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <HBox styleClass="toolbar" spacing="14.0">
            <children>
                <Label fx:id="etichettaNumeroArticoli" styleClass="stat-chip" text="Numero articoli: -" />
                <Button fx:id="bottoneAggiungiArticolo" text="Aggiungi un nuovo articolo" onAction="#onAggiungiArticolo" />
                <Button fx:id="bottoneEliminaArticolo" styleClass="danger" text="Elimina un articolo" onAction="#onEliminaArticolo" />
            </children>
        </HBox>

        <Label fx:id="etichettaTitoloInventario" styleClass="section-title" text="Inventario" />

        <TableView fx:id="tabellaArticoli" VBox.vgrow="ALWAYS" editable="true">
            <columns>
                <TableColumn fx:id="colonnaNomeArticolo" text="Nome articolo" prefWidth="360.0" />
                <TableColumn fx:id="colonnaQuantita" text="Quantità" prefWidth="120.0" />
            </columns>
        </TableView>

    </children>
</VBox>
