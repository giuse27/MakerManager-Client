<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.makermanagerclient.controller.ImpostazioniController">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label text="Impostazioni" />

        <Label text="Soglia progetti mancanti (numero massimo di elementi mancanti perché un progetto compaia tra i consigliati, oltre a quelli già realizzabili)" wrapText="true" />

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="campoSogliaMancanti" prefHeight="27.0" prefWidth="300.0" />
                <Button onAction="#onSalva" text="Salva" />
                <Button onAction="#onRipristinaPredefinito" text="Ripristina predefinito" />
            </children>
        </HBox>

        <Label fx:id="etichettaEsito" />

    </children>
</VBox>
