<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.CatalogoController"
      spacing="16.0">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <children>

        <Label text="Catalogo" styleClass="panel-title" />

        <!-- Visualizza elementi in catalogo -->
        <VBox styleClass="card" spacing="10.0">
            <children>
                <Label text="Visualizza catalogo" styleClass="card-title" />
                <Button fx:id="bottoneLista" text="GET /api/catalogo" maxWidth="Infinity" onAction="#onLista" />
            </children>
        </VBox>

        <!-- Aggiungi elemento al catalogo -->
        <VBox styleClass="card" spacing="10.0">
            <children>
                <Label text="Aggiungi elemento" styleClass="card-title" />
                <TextField fx:id="campoNome" promptText="nome" />
                <TextField fx:id="campoDescrizione" promptText="descrizione" />
                <ComboBox fx:id="comboTipologia" maxWidth="Infinity" promptText="tipologia" />
                <Button fx:id="bottoneCrea" text="POST /api/catalogo" maxWidth="Infinity" onAction="#onCrea" />
            </children>
        </VBox>

        <!-- Elimina elemento dal catalogo -->
        <VBox styleClass="card" spacing="10.0">
            <children>
                <Label text="Elimina elemento" styleClass="card-title" />
                <HBox spacing="10.0">
                    <children>
                        <Spinner fx:id="spinnerIdElimina" editable="true" prefWidth="110.0" />
                        <Button fx:id="bottoneElimina" styleClass="danger" text="DELETE /api/catalogo/{id}" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onElimina" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label text="Output" styleClass="output-title" />
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="output-scroll">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" styleClass="output-area" />
            </content>
        </ScrollPane>

    </children>
</VBox>
