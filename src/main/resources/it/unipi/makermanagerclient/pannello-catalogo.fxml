<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unipi.makermanagerclient.controller.CatalogoController"
      spacing="10.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <children>

        <Label text="Catalogo" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

        <!-- Visualizza elementi in catalogo -->
        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <Label text="Visualizza catalogo" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                <Button fx:id="bottoneLista" text="GET /api/catalogo" maxWidth="Infinity" onAction="#onLista" />
            </children>
        </VBox>

        <!-- Aggiungi elemento al catalogo -->
        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <Label text="Aggiungi elemento" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                <TextField fx:id="campoNome" promptText="nome" />
                <TextField fx:id="campoDescrizione" promptText="descrizione" />
                <ComboBox fx:id="comboTipologia" maxWidth="Infinity" promptText="tipologia" />
                <Button fx:id="bottoneCrea" text="POST /api/catalogo" maxWidth="Infinity" onAction="#onCrea" />
            </children>
        </VBox>

        <!-- Elimina elemento dal catalogo -->
        <VBox style="-fx-background-color: #f4f4f4; -fx-background-radius: 6;" spacing="6.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <Label text="Elimina elemento" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                <HBox spacing="6.0">
                    <children>
                        <Spinner fx:id="spinnerIdElimina" editable="true" prefWidth="90.0" />
                        <Button fx:id="bottoneElimina" text="DELETE /api/catalogo/{id}" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onElimina" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label text="Output" style="-fx-font-weight: bold;" />
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <content>
                <TextArea fx:id="areaOutput" editable="false" wrapText="true" />
            </content>
        </ScrollPane>

    </children>
</VBox>
